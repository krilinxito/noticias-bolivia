---
import Layout from '../layouts/Layout.astro'
import PortadaContenido from '../components/PortadaContenido'
import { getTemas } from '../lib/api'
import { detectarCategoria } from '../lib/categorias'

let temas: any[] = []
try { temas = await getTemas(80) } catch {}

const temasConCat = temas.map((t: any) => ({
  ...t,
  categoria: detectarCategoria(t.keywords ?? []),
}))
---
<Layout title="Portada">
  <PortadaContenido temas={temasConCat} client:load />
</Layout>
