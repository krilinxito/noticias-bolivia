---
import Layout from '../layouts/Layout.astro'
import PortadaContenido from '../components/PortadaContenido'
import ChatWidget from '../components/ChatWidget'
import { getEventos } from '../lib/api'
import { detectarCategoria } from '../lib/categorias'

let eventos: any[] = []
try { eventos = await getEventos(80) } catch {}

const eventosConCat = eventos.map((ev: any) => ({
  ...ev,
  categoria: detectarCategoria(ev.temas ?? []),
}))
---
<Layout title="Portada">
  <PortadaContenido eventos={eventosConCat} client:load />
  <ChatWidget client:load />
</Layout>
