---
import Layout from '../layouts/Layout.astro'
import SerieTemporalChart from '../components/SerieTemporalChart'
import { getEventos, getNoticias } from '../lib/api'
import { detectarCategoria } from '../lib/categorias'

let eventos: any[] = []
let noticias: any[] = []
try {
  ;[eventos, noticias] = await Promise.all([
    getEventos(200),
    getNoticias({ limit: 300, orden: 'fecha' }),
  ])
} catch {}

// Rango basado solo en fechas de eventos (los artículos pueden tener fechas viejas)
const fechasEv = eventos.map(e => new Date(e.fecha_deteccion).getTime()).filter(t => !isNaN(t))
const maxMs = fechasEv.length > 0 ? Math.max(...fechasEv) + 864e5 : Date.now()
const minEvMs = fechasEv.length > 0 ? Math.min(...fechasEv) : maxMs - 7 * 864e5
// Ventana: desde el primer evento hasta hoy, máximo 30 días hacia atrás
const minMs = Math.max(minEvMs - 864e5, maxMs - 30 * 864e5)

const minFecha = new Date(minMs).toISOString()
const maxFecha = new Date(maxMs).toISOString()

// Densidad: artículos por día
const densidad: Record<string, number> = {}
for (const a of noticias) {
  if (!a.fecha_publicacion) continue
  const dia = a.fecha_publicacion.slice(0, 10)
  densidad[dia] = (densidad[dia] ?? 0) + 1
}

// Eventos enriquecidos con categoría
const eventosConCat = eventos.map(ev => ({
  id: ev.id,
  titulo: ev.titulo,
  fecha_deteccion: ev.fecha_deteccion,
  score_importancia: ev.score_importancia ?? 0,
  categoria: detectarCategoria(ev.temas ?? []),
  mediosCount: Object.keys(ev.articulos_por_medio ?? {}).length,
  mediosNombres: Object.keys(ev.articulos_por_medio ?? {}),
}))

// Categorías con al menos 1 evento, ordenadas por frecuencia
const cuentaCat: Record<string, number> = {}
for (const ev of eventosConCat) {
  cuentaCat[ev.categoria] = (cuentaCat[ev.categoria] ?? 0) + 1
}
const categorias = Object.entries(cuentaCat)
  .sort((a, b) => b[1] - a[1])
  .map(([cat]) => cat)

// Días únicos con datos
const diasConDatos = Object.keys(densidad).length
const haySuficientesDatos = diasConDatos >= 2
---
<Layout title="Serie temporal">
  <div style="max-width:60rem; margin:0 auto; padding:2rem;">

    <div style="border-bottom:3px double var(--border-dark); margin-bottom:1.5rem; padding-bottom:0.75rem; display:flex; justify-content:space-between; align-items:baseline;">
      <div>
        <h2 style="font-family:'Playfair Display',Georgia,serif; font-size:1.6rem; font-weight:700;">Serie temporal</h2>
        <p style="font-family:'IM Fell English',Georgia,serif; font-style:italic; font-size:0.85rem; color:var(--ink-light); margin-top:0.2rem;">
          {eventos.length} eventos · {diasConDatos} días con cobertura
        </p>
      </div>
      <a href="/timeline" style="font-family:'IM Fell English',Georgia,serif; font-size:0.75rem; color:var(--ink-light); text-decoration:none;">
        ← Cronología
      </a>
    </div>

    {!haySuficientesDatos ? (
      <div style="border:1px solid var(--border); padding:2rem; text-align:center;">
        <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.9rem; color:var(--ink-light); font-style:italic;">
          Datos insuficientes — el gráfico se irá completando con el tiempo.
        </p>
        <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.78rem; color:var(--ink-light); margin-top:0.5rem;">
          Se necesitan al menos 2 días de artículos publicados.
        </p>
      </div>
    ) : (
      <div>
        <div style="border:1px solid var(--border); padding:1rem 1.25rem; margin-bottom:1rem;">
          <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--ink-light); margin-bottom:0.75rem;">
            Aparición de eventos por categoría · tamaño = importancia relativa
          </p>
          <SerieTemporalChart
            client:load
            eventos={eventosConCat}
            densidad={densidad}
            categorias={categorias}
            minFecha={minFecha}
            maxFecha={maxFecha}
          />
        </div>

        <!-- Leyenda -->
        <div style="display:flex; flex-wrap:wrap; gap:1rem; font-family:'IM Fell English',Georgia,serif; font-size:0.7rem; color:var(--ink-light);">
          <span>● Tamaño del punto = relevancia del evento</span>
          <span>· Click en punto → detalle del evento</span>
          <span>· Barras grises = volumen de artículos publicados por día</span>
        </div>
      </div>
    )}

  </div>
</Layout>
