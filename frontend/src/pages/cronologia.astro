---
import Layout from '../layouts/Layout.astro'
import CronologiaChart from '../components/CronologiaChart'
import { getEpisodios } from '../lib/api'
import { detectarCategoria, CAT_COLOR } from '../lib/categorias'

let episodios: any[] = []
try {
  episodios = await getEpisodios(200)
} catch {}

function lerpHex(a: string, b: string, t: number): string {
  const parse = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]
  const [ar, ag, ab] = parse(a)
  const [br, bg, bb] = parse(b)
  return `rgb(${Math.round(ar + (br - ar) * t)},${Math.round(ag + (bg - ag) * t)},${Math.round(ab + (bb - ab) * t)})`
}
function colorSesgo(s: number | null): string {
  if (s === null || s === undefined) return 'var(--border-dark)'
  const t = (s + 1) / 2
  return t < 0.5 ? lerpHex('#8b1a1a', '#8a7a62', t * 2) : lerpHex('#8a7a62', '#1a4a1a', (t - 0.5) * 2)
}

const episodiosConMetrics = episodios.map((ep: any) => ({
  id: ep.id,
  titulo: ep.titulo,
  fecha_deteccion: ep.fecha_deteccion,
  score_importancia: ep.score_importancia ?? 0,
  categoria: detectarCategoria(ep.keywords ?? []),
  sesgo_promedio: ep.sesgo_promedio ?? null,
  mediosCount: ep.medios_count ?? ep.medios?.length ?? 0,
  mediosNombres: ep.medios ?? [],
}))

const fechasEv = episodiosConMetrics.map((e: any) => new Date(e.fecha_deteccion).getTime()).filter((t: number) => !isNaN(t))
const maxMs = fechasEv.length > 0 ? Math.max(...fechasEv) + 864e5 : Date.now()
const minEvMs = fechasEv.length > 0 ? Math.min(...fechasEv) : maxMs - 7 * 864e5
const minMs = Math.max(minEvMs - 864e5, maxMs - 30 * 864e5)
const minFecha = new Date(minMs).toISOString()
const maxFecha = new Date(maxMs).toISOString()

const cuentaCat: Record<string, number> = {}
for (const ep of episodiosConMetrics) {
  cuentaCat[ep.categoria] = (cuentaCat[ep.categoria] ?? 0) + 1
}
const categorias = Object.entries(cuentaCat).sort((a, b) => b[1] - a[1]).map(([cat]) => cat)

const episodiosOrdenados = [...episodiosConMetrics].sort(
  (a: any, b: any) => new Date(b.fecha_deteccion).getTime() - new Date(a.fecha_deteccion).getTime()
)

function formatFecha(iso: string): string {
  return new Date(iso).toLocaleDateString('es-BO', {
    timeZone: 'America/La_Paz',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
}

function sesgoLabel(s: number | null): string {
  if (s === null) return 'Sin sesgo'
  if (s > 0.2) return `Pos. (+${s.toFixed(2)})`
  if (s < -0.2) return `Neg. (${s.toFixed(2)})`
  return `Neutral (${s >= 0 ? '+' : ''}${s.toFixed(2)})`
}

const haySuficientesDatos = episodiosConMetrics.length >= 1 && fechasEv.length >= 2
---
<Layout title="Cronología">
  <div style="max-width:60rem; margin:0 auto; padding:2rem;">

    <div style="border-bottom:3px double var(--border-dark); margin-bottom:1.5rem; padding-bottom:0.75rem;">
      <h2 style="font-family:'Playfair Display',Georgia,serif; font-size:1.6rem; font-weight:700;">Cronología de episodios</h2>
      <p style="font-family:'IM Fell English',Georgia,serif; font-style:italic; font-size:0.85rem; color:var(--ink-light); margin-top:0.2rem;">
        {episodiosConMetrics.length} episodios · color = sesgo editorial · tamaño = importancia
      </p>
    </div>

    {!haySuficientesDatos ? (
      <div style="border:1px solid var(--border); padding:2rem; text-align:center; margin-bottom:1.5rem;">
        <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.9rem; color:var(--ink-light); font-style:italic;">
          Aún no hay suficientes episodios — el gráfico se irá completando con el ciclo diario.
        </p>
      </div>
    ) : (
      <div style="border:1px solid var(--border); padding:1rem 1.25rem; margin-bottom:1.5rem;">
        <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--ink-light); margin-bottom:0.75rem;">
          Episodios por categoría · color = sesgo editorial · tamaño = relevancia
        </p>
        <CronologiaChart
          client:load
          eventos={episodiosConMetrics}
          categorias={categorias}
          minFecha={minFecha}
          maxFecha={maxFecha}
        />
      </div>
    )}

    <!-- Tarjetas de episodios -->
    {episodiosOrdenados.length === 0 ? (
      <p style="font-family:'IM Fell English',Georgia,serif; font-style:italic; color:var(--ink-light);">Sin episodios disponibles.</p>
    ) : (
      <div>
        <p style="font-family:'IM Fell English',Georgia,serif; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--ink-light); margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.5rem;">
          Todos los episodios — más recientes primero
        </p>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:0.85rem;">
          {episodiosOrdenados.map((ep: any) => {
            const catColor = CAT_COLOR[ep.categoria] ?? '#5a4a32'
            const sc = colorSesgo(ep.sesgo_promedio)
            const borderColor = ep.sesgo_promedio !== null ? sc : 'var(--border)'
            return (
              <a href={`/episodios/${ep.id}`} style={`display:block; border:1px solid var(--border); border-left:4px solid ${borderColor}; padding:0.85rem 1rem; text-decoration:none; color:var(--ink);`}>
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.35rem;">
                  <span style={`font-family:'IM Fell English',Georgia,serif; font-size:0.62rem; text-transform:uppercase; letter-spacing:0.08em; color:${catColor};`}>{ep.categoria}</span>
                  <span style="font-family:'IM Fell English',Georgia,serif; font-size:0.62rem; color:var(--ink-light);">{ep.mediosCount} medios</span>
                </div>
                <p style="font-family:Georgia,serif; font-size:0.87rem; line-height:1.35; margin-bottom:0.5rem;">
                  {ep.titulo}
                </p>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="font-family:'IM Fell English',Georgia,serif; font-size:0.62rem; color:var(--ink-light);">{formatFecha(ep.fecha_deteccion)}</span>
                  <span style={`font-family:'IM Fell English',Georgia,serif; font-size:0.62rem; color:${ep.sesgo_promedio !== null ? borderColor : 'var(--ink-light)'};`}>
                    {sesgoLabel(ep.sesgo_promedio)}
                  </span>
                </div>
              </a>
            )
          })}
        </div>
      </div>
    )}

  </div>
</Layout>
